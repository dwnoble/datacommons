{
  "@context": {
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "rdf:Property",
      "@type": "rdfs:Class",
      "rdfs:comment": "The class of RDF properties.",
      "rdfs:isDefinedBy": {
        "@id": "rdf:"
      },
      "rdfs:label": "Property",
      "rdfs:subClassOf": {
        "@id": "rdfs:Resource"
      }
    },
    {
      "@id": "rdf:Alt",
      "@type": "rdfs:Class",
      "rdfs:comment": "The class of containers of alternatives.",
      "rdfs:isDefinedBy": {
        "@id": "rdf:"
      },
      "rdfs:label": "Alt",
      "rdfs:subClassOf": {
        "@id": "rdfs:Container"
      }
    },
    {
      "@id": "rdf:object",
      "@type": "rdf:Property",
      "rdfs:comment": "The object of the subject RDF statement.",
      "rdfs:domain": {
        "@id": "rdf:Statement"
      },
      "rdfs:isDefinedBy": {
        "@id": "rdf:"
      },
      "rdfs:label": "object",
      "rdfs:range": {
        "@id": "rdfs:Resource"
      }
    },
    {
      "@id": "rdf:CompoundLiteral",
      "@type": "rdfs:Class",
      "rdfs:comment": "A class representing a compound literal.",
      "rdfs:isDefinedBy": {
        "@id": "rdf:"
      },
      "rdfs:label": "CompoundLiteral",
      "rdfs:seeAlso": {
        "@id": "https://www.w3.org/TR/json-ld11/#the-rdf-compoundliteral-class-and-the-rdf-language-and-rdf-direction-properties"
      },
      "rdfs:subClassOf": {
        "@id": "rdfs:Resource"
      }
    },
    {
      "@id": "rdf:subject",
      "@type": "rdf:Property",
      "rdfs:comment": "The subject of the subject RDF statement.",
      "rdfs:domain": {
        "@id": "rdf:Statement"
      },
      "rdfs:isDefinedBy": {
        "@id": "rdf:"
      },
      "rdfs:label": "subject",
      "rdfs:range": {
        "@id": "rdfs:Resource"
      }
    },
    {
      "@id": "rdf:List",
      "@type": "rdfs:Class",
      "rdfs:comment": "The class of RDF Lists.",
      "rdfs:isDefinedBy": {
        "@id": "rdf:"
      },
      "rdfs:label": "List",
      "rdfs:subClassOf": {
        "@id": "rdfs:Resource"
      }
    },
    {
      "@id": "rdf:JSON",
      "@type": "rdfs:Datatype",
      "rdfs:comment": "The datatype of RDF literals storing JSON content.",
      "rdfs:isDefinedBy": {
        "@id": "rdf:"
      },
      "rdfs:label": "JSON",
      "rdfs:seeAlso": {
        "@id": "https://www.w3.org/TR/json-ld11/#the-rdf-json-datatype"
      },
      "rdfs:subClassOf": {
        "@id": "rdfs:Literal"
      }
    },
    {
      "@id": "rdf:rest",
      "@type": "rdf:Property",
      "rdfs:comment": "The rest of the subject RDF list after the first item.",
      "rdfs:domain": {
        "@id": "rdf:List"
      },
      "rdfs:isDefinedBy": {
        "@id": "rdf:"
      },
      "rdfs:label": "rest",
      "rdfs:range": {
        "@id": "rdf:List"
      }
    },
    {
      "@id": "rdf:HTML",
      "@type": "rdfs:Datatype",
      "rdfs:comment": "The datatype of RDF literals storing fragments of HTML content",
      "rdfs:isDefinedBy": {
        "@id": "rdf:"
      },
      "rdfs:label": "HTML",
      "rdfs:seeAlso": {
        "@id": "http://www.w3.org/TR/rdf11-concepts/#section-html"
      },
      "rdfs:subClassOf": {
        "@id": "rdfs:Literal"
      }
    },
    {
      "@id": "rdf:first",
      "@type": "rdf:Property",
      "rdfs:comment": "The first item in the subject RDF list.",
      "rdfs:domain": {
        "@id": "rdf:List"
      },
      "rdfs:isDefinedBy": {
        "@id": "rdf:"
      },
      "rdfs:label": "first",
      "rdfs:range": {
        "@id": "rdfs:Resource"
      }
    },
    {
      "@id": "rdf:Bag",
      "@type": "rdfs:Class",
      "rdfs:comment": "The class of unordered containers.",
      "rdfs:isDefinedBy": {
        "@id": "rdf:"
      },
      "rdfs:label": "Bag",
      "rdfs:subClassOf": {
        "@id": "rdfs:Container"
      }
    },
    {
      "@id": "rdf:direction",
      "@type": "rdf:Property",
      "rdfs:comment": "The base direction component of a CompoundLiteral.",
      "rdfs:domain": {
        "@id": "rdf:CompoundLiteral"
      },
      "rdfs:isDefinedBy": {
        "@id": "rdf:"
      },
      "rdfs:label": "direction",
      "rdfs:seeAlso": {
        "@id": "https://www.w3.org/TR/json-ld11/#the-rdf-compoundliteral-class-and-the-rdf-language-and-rdf-direction-properties"
      }
    },
    {
      "@id": "rdf:type",
      "@type": "rdf:Property",
      "rdfs:comment": "The subject is an instance of a class.",
      "rdfs:domain": {
        "@id": "rdfs:Resource"
      },
      "rdfs:isDefinedBy": {
        "@id": "rdf:"
      },
      "rdfs:label": "type",
      "rdfs:range": {
        "@id": "rdfs:Class"
      }
    },
    {
      "@id": "rdf:nil",
      "@type": "rdf:List",
      "rdfs:comment": "The empty list, with no items in it. If the rest of a list is nil then the list has no more items in it.",
      "rdfs:isDefinedBy": {
        "@id": "rdf:"
      },
      "rdfs:label": "nil"
    },
    {
      "@id": "rdf:XMLLiteral",
      "@type": "rdfs:Datatype",
      "rdfs:comment": "The datatype of XML literal values.",
      "rdfs:isDefinedBy": {
        "@id": "rdf:"
      },
      "rdfs:label": "XMLLiteral",
      "rdfs:subClassOf": {
        "@id": "rdfs:Literal"
      }
    },
    {
      "@id": "rdf:Statement",
      "@type": "rdfs:Class",
      "rdfs:comment": "The class of RDF statements.",
      "rdfs:isDefinedBy": {
        "@id": "rdf:"
      },
      "rdfs:label": "Statement",
      "rdfs:subClassOf": {
        "@id": "rdfs:Resource"
      }
    },
    {
      "@id": "rdf:value",
      "@type": "rdf:Property",
      "rdfs:comment": "Idiomatic property used for structured values.",
      "rdfs:domain": {
        "@id": "rdfs:Resource"
      },
      "rdfs:isDefinedBy": {
        "@id": "rdf:"
      },
      "rdfs:label": "value",
      "rdfs:range": {
        "@id": "rdfs:Resource"
      }
    },
    {
      "@id": "rdf:PlainLiteral",
      "@type": "rdfs:Datatype",
      "rdfs:comment": "The class of plain (i.e. untyped) literal values, as used in RIF and OWL 2",
      "rdfs:isDefinedBy": {
        "@id": "rdf:"
      },
      "rdfs:label": "PlainLiteral",
      "rdfs:seeAlso": {
        "@id": "http://www.w3.org/TR/rdf-plain-literal/"
      },
      "rdfs:subClassOf": {
        "@id": "rdfs:Literal"
      }
    },
    {
      "@id": "rdf:",
      "@type": "http://www.w3.org/2002/07/owl#Ontology",
      "http://purl.org/dc/elements/1.1/date": "2019-12-16",
      "http://purl.org/dc/elements/1.1/description": "This is the RDF Schema for the RDF vocabulary terms in the RDF Namespace, defined in RDF 1.1 Concepts.",
      "http://purl.org/dc/elements/1.1/title": "The RDF Concepts Vocabulary (RDF)"
    },
    {
      "@id": "rdf:langString",
      "@type": "rdfs:Datatype",
      "rdfs:comment": "The datatype of language-tagged string values",
      "rdfs:isDefinedBy": {
        "@id": "rdf:"
      },
      "rdfs:label": "langString",
      "rdfs:seeAlso": {
        "@id": "http://www.w3.org/TR/rdf11-concepts/#section-Graph-Literal"
      },
      "rdfs:subClassOf": {
        "@id": "rdfs:Literal"
      }
    },
    {
      "@id": "rdf:predicate",
      "@type": "rdf:Property",
      "rdfs:comment": "The predicate of the subject RDF statement.",
      "rdfs:domain": {
        "@id": "rdf:Statement"
      },
      "rdfs:isDefinedBy": {
        "@id": "rdf:"
      },
      "rdfs:label": "predicate",
      "rdfs:range": {
        "@id": "rdfs:Resource"
      }
    },
    {
      "@id": "rdf:language",
      "@type": "rdf:Property",
      "rdfs:comment": "The language component of a CompoundLiteral.",
      "rdfs:domain": {
        "@id": "rdf:CompoundLiteral"
      },
      "rdfs:isDefinedBy": {
        "@id": "rdf:"
      },
      "rdfs:label": "language",
      "rdfs:seeAlso": {
        "@id": "https://www.w3.org/TR/json-ld11/#the-rdf-compoundliteral-class-and-the-rdf-language-and-rdf-direction-properties"
      }
    },
    {
      "@id": "rdf:Seq",
      "@type": "rdfs:Class",
      "rdfs:comment": "The class of ordered containers.",
      "rdfs:isDefinedBy": {
        "@id": "rdf:"
      },
      "rdfs:label": "Seq",
      "rdfs:subClassOf": {
        "@id": "rdfs:Container"
      }
    }
  ]
}